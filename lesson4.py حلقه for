# حلقه for برای تکرار یک دستور چند بار استفاده می‌شود.

# مثال 1: چاپ اعداد 1 تا 5
for i in range(1, 6):
    print(i)


# مثال 2: چاپ یک پیام 5 بار
for i in range(5):
    print("Hello Python!")


# مثال 3: محاسبه مربع اعداد 1 تا 5
for i in range(1, 6):
    print(i, "squared =", i ** 2)


# مثال 4: چاپ اعداد زوج 2 تا 10
for i in range(2, 11, 2):
    print(i)


# مثال 5: محاسبه مجموع اعداد 1 تا 10
total = 0

for i in range(1, 11):
    total = total + i

print("Sum =", total)


