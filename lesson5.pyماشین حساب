# دریافت عدد اول
num1 = float(input("Enter the first number: "))

# دریافت عملگر
operator = input("Enter operator (+, -, *, /): ")

# دریافت عدد دوم
num2 = float(input("Enter the second number: "))


# انجام محاسبات
if operator == "+":
    result = num1 + num2

elif operator == "-":
    result = num1 - num2

elif operator == "*":
    result = num1 * num2

elif operator == "/":
    if num2 != 0:
        result = num1 / num2
    else:
        result = "Error: Cannot divide by zero!"

else:
    result = "Invalid operator!"


# نمایش نتیجه
print("Result:", result)
